---
import ProtectedLayout from "@/layouts/ProtectedLayout.astro";
import EmptyState from "@/components/library/EmptyState.astro";
import { FlashcardList } from "@/components/library/FlashcardList";
import { getFlashcards } from "@/lib/services/flashcards.service";
import type { LibraryFiltersViewModel } from "@/types";

// Get authenticated user from locals (set by middleware)
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/login");
}

// Parse query parameters for initial filters
const url = new URL(Astro.request.url);
const searchParams = url.searchParams;

const initialFilters: Partial<LibraryFiltersViewModel> = {};

const sort = searchParams.get("sort");
if (sort === "created_at" || sort === "updated_at" || sort === "due_date") {
  initialFilters.sort = sort;
}

const order = searchParams.get("order");
if (order === "asc" || order === "desc") {
  initialFilters.order = order;
}

const createdByAi = searchParams.get("created_by_ai");
if (createdByAi === "ai" || createdByAi === "manual") {
  initialFilters.createdByAi = createdByAi;
}

// Fetch initial data from server
const supabase = Astro.locals.supabase;
const initialData = await getFlashcards(
  user.id,
  {
    limit: 20,
    offset: 0,
    sort: initialFilters.sort || "created_at",
    order: initialFilters.order || "desc",
    created_by_ai:
      initialFilters.createdByAi === "ai" ? true : initialFilters.createdByAi === "manual" ? false : undefined,
  },
  supabase
);

const isEmpty = initialData.pagination.total === 0;
---

<ProtectedLayout title="Library">
  <div class="container mx-auto px-4 py-8">
    {isEmpty ? <EmptyState /> : <FlashcardList client:load initialData={initialData} initialFilters={initialFilters} />}
  </div>
</ProtectedLayout>
